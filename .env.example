# General QA Agent - public example configuration
# Copy to .env locally. Never commit your real .env.

# Runtime
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
API_WORKERS=1
JOB_WORKERS=2
DASHBOARD_CACHE_SECONDS=2
MAX_UPLOAD_MB=25

# LLM configuration
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GENERATION_MODEL=gpt-4.1-mini
SIMULATION_MODEL=gpt-4.1-mini
EVALUATION_MODEL=gpt-4.1-mini
DIAGNOSIS_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
AI_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=2
MODEL_PRICING_JSON={}

# QA behavior
MAX_GENERATED_TEST_CASES=24
MAX_CONVERSATION_TURNS=18
MAX_PROMPT_CHARS=28000
RAG_CHUNK_CHARS=1400
RAG_OVERLAP_CHARS=180
RAG_TOP_K=18
EMBEDDING_BATCH_SIZE=48
ENABLE_DEEPEVAL=true
EVALUATION_THRESHOLD=0.75
ENABLE_FAILURE_DIAGNOSIS=true
PERFORMANCE_WARNING_MS=4000
PERFORMANCE_CRITICAL_MS=8000
PERFORMANCE_FAIL_MS=20000
ENFORCE_DOCUMENTED_RESPONSE_SLA=false
DEEPEVAL_TELEMETRY_OPT_OUT=1

# Optional Twilio-style webhook metadata
TWILIO_ACCOUNT_SID=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_COUNTRY=US
TWILIO_FROM_STATE=
TWILIO_FROM_CITY=
TWILIO_FROM_ZIP=
TWILIO_TO_COUNTRY=US
TWILIO_TO_STATE=
TWILIO_TO_CITY=
TWILIO_TO_ZIP=
QA_TEST_CHANNEL=Automated_Test_System

# Local data paths
DATA_DIR=./data
DATABASE_PATH=./data/qa_agent.db
UPLOAD_DIR=./data/uploads
REPORT_DIR=./data/reports
DASHBOARD_DIST=./dashboard/dist
